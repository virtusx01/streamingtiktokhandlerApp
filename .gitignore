# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# logs and temp
*.log
tmp/
cache/
scratch/
__pycache__/
*.pyc

# media / test artifacts
*.wav
test*.png

# android build
driver-apk/.gradle/
driver-apk/.idea/
driver-apk/local.properties
driver-apk/**/build/

# user data and credentials
data/wa_session/
data/*.db
data/*.db-journal
data/*.bak
.gemini/
supabase/.temp/
